<?xml version="1.0" encoding="UTF-8"?>
<!-- Дополнение к definitions/logger/logger_defs.xml (logger def RomRaider) для AZ1G101M,
     ID ЭБУ 5C42584007: адреса RAM, найденные дизассемблером (отсечка топлива на сбросе
     газа, задний O2). Логгер редактора добавляет их к основному файлу; параметр с тем же
     id не перекрывается (src/logger/core/defs.py). В logger def RomRaider их можно
     вставить в <ecuparams> протокола SSM как есть. -->
<logger version="370">
    <protocols>
        <protocol id="SSM">
            <ecuparams>
                <ecuparam id="E9001" name="Decel Fuel Cut Timer*" desc="E9001-Time since throttle closed; fuel is cut in steps as it passes the thresholds. ms assumes 8 ms per count (unconfirmed), raw = counts." target="1">
                    <ecu id="5C42584007">
                        <address length="2">0xFF7778</address>
                    </ecu>
                    <conversions>
                        <conversion units="ms" storagetype="uint16" expr="x*8" format="0" gauge_min="0" gauge_max="3000" gauge_step="500" />
                        <conversion units="raw" storagetype="uint16" expr="x" format="0" gauge_min="0" gauge_max="500" gauge_step="100" />
                    </conversions>
                </ecuparam>
                <ecuparam id="E9002" name="Decel Fuel Cut Stage*" desc="E9002-Cylinders with fuel cut on decel: 0 = none, 1..4 = number of cylinders cut." target="1">
                    <ecu id="5C42584007">
                        <address>0xFF7768</address>
                    </ecu>
                    <conversions>
                        <conversion units="raw" expr="x" format="0" gauge_min="0" gauge_max="4" gauge_step="1" />
                    </conversions>
                </ecuparam>
                <ecuparam id="E9003" name="Decel Fuel Cut Threshold 1st Cyl*" desc="E9003-Selected D1: timer value at which the first cylinder is cut. Shows which delay table is in use." target="1">
                    <ecu id="5C42584007">
                        <address length="2">0xFF7760</address>
                    </ecu>
                    <conversions>
                        <conversion units="ms" storagetype="uint16" expr="x*8" format="0" gauge_min="0" gauge_max="3000" gauge_step="500" />
                        <conversion units="raw" storagetype="uint16" expr="x" format="0" gauge_min="0" gauge_max="500" gauge_step="100" />
                    </conversions>
                </ecuparam>
                <ecuparam id="E9004" name="Decel Fuel Cut Threshold All Cyl*" desc="E9004-Timer value at which all cylinders are cut." target="1">
                    <ecu id="5C42584007">
                        <address length="2">0xFF7766</address>
                    </ecu>
                    <conversions>
                        <conversion units="ms" storagetype="uint16" expr="x*8" format="0" gauge_min="0" gauge_max="3000" gauge_step="500" />
                        <conversion units="raw" storagetype="uint16" expr="x" format="0" gauge_min="0" gauge_max="500" gauge_step="100" />
                    </conversions>
                </ecuparam>
                <ecuparam id="E9005" name="Decel Fuel Cut Enabled*" desc="E9005-Decel fuel cut conditions met (1) / not met (0): throttle closed, RPM above resume threshold, etc." target="1">
                    <ecu id="5C42584007">
                        <address>0xFF776C</address>
                    </ecu>
                    <conversions>
                        <conversion units="raw" expr="x" format="0" gauge_min="0" gauge_max="1" gauge_step="1" />
                    </conversions>
                </ecuparam>
                <ecuparam id="E9006" name="Decel Fuel Cut Alt Flag (6168)*" desc="E9006-When not 0 the (Alt) decel delay tables are used. Meaning unknown." target="1">
                    <ecu id="5C42584007">
                        <address>0xFF6168</address>
                    </ecu>
                    <conversions>
                        <conversion units="raw" expr="x" format="0" gauge_min="0" gauge_max="255" gauge_step="32" />
                    </conversions>
                </ecuparam>
                <ecuparam id="E9007" name="Neutral Switch (67CB)*" desc="E9007-Gearbox neutral switch: 1 = neutral. In neutral decel fuel cut uses the Decel Fuel Cut Delay (Neutral) table." target="1">
                    <ecu id="5C42584007">
                        <address>0xFF67CB</address>
                    </ecu>
                    <conversions>
                        <conversion units="raw" expr="x" format="0" gauge_min="0" gauge_max="255" gauge_step="32" />
                    </conversions>
                </ecuparam>
                <ecuparam id="E9008" name="Time Since Engine Start (5F8C)*" desc="E9008-Time since engine start, 8 ms per count, stops at 65535 (about 524 s)." target="1">
                    <ecu id="5C42584007">
                        <address length="2">0xFF5F8C</address>
                    </ecu>
                    <conversions>
                        <conversion units="s" storagetype="uint16" expr="x*0.008" format="0.0" gauge_min="0" gauge_max="525" gauge_step="60" />
                        <conversion units="raw" storagetype="uint16" expr="x" format="0" gauge_min="0" gauge_max="500" gauge_step="100" />
                    </conversions>
                </ecuparam>
                <ecuparam id="E9009" name="A/F Correction #3 Output*" desc="E9009-Rear O2 (AF3) correction after the clamp; with AF 3 Correction Limits = 0 it should stay 0." target="1">
                    <ecu id="5C42584007">
                        <address length="4">0xFF743C</address>
                    </ecu>
                    <conversions>
                        <conversion units="raw" storagetype="float" expr="x" format="0.0000" gauge_min="-1" gauge_max="1" gauge_step="0.25" />
                    </conversions>
                </ecuparam>
                <ecuparam id="E9010" name="A/F Correction #3 Input*" desc="E9010-Rear O2 (AF3) controller input before the clamp." target="1">
                    <ecu id="5C42584007">
                        <address length="4">0xFF65EC</address>
                    </ecu>
                    <conversions>
                        <conversion units="raw" storagetype="float" expr="x" format="0.0000" gauge_min="-1" gauge_max="1" gauge_step="0.25" />
                    </conversions>
                </ecuparam>
            </ecuparams>
        </protocol>
    </protocols>
</logger>
